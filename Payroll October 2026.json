      "parameters": {
        "jsCode": "// Read the engine response from the HTTP node (our direct input is the\n// sheet-create result of Ensure Result Tab, not the engine payload).\nconst payload = $('Call Payroll Engine').first().json;\nif (payload && payload.error) {\n  throw new Error('Payroll engine returned an error: ' + payload.error);\n}\nconst rows = (payload && payload.rows) || [];\nif (rows.length === 0) {\n  throw new Error('Payroll engine returned no rows');\n}\nreturn rows.map((row) => {\n  const clean = { ...row };\n  delete clean.reconciliation_code;\n  return { json: clean };\n});"
