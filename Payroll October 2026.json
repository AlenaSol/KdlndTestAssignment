    {
      "parameters": {
        "jsCode": "// Build a Sheets batchUpdate payload: borders for the used range + one\n// conditional-format rule painting matches_manual=TRUE rows light green.\n// Existing conditional rules on the tab are deleted first so re-runs never\n// accumulate duplicates.\nconst info = $input.first().json;\nconst sheets = info.sheets || [];\nconst target = sheets.find(function (s) {\n  return s.properties && s.properties.title === 'payroll_oct_result';\n});\nif (!target || !target.properties || target.properties.sheetId === undefined) {\n  throw new Error('payroll_oct_result tab not found; cannot apply formatting');\n}\nconst sheetId = target.properties.sheetId;\nconst existingRules = (target.conditionalFormats || []).length;\n\nconst extract = $('Extract Result Rows');\nconst items = typeof extract.all === 'function' ? extract.all() : extract.all;\nconst rowCount = 1 + (items || []).length; // header + data rows\nconst COLUMN_COUNT = 28; // A..AA, matches_manual is column U (21st)\n\nconst requests = [];\nfor (let i = 0; i < existingRules; i++) {\n  requests.push({ deleteConditionalFormatRule: { sheetId: sheetId, index: 0 } });\n}\nrequests.push({\n  repeatCell: {\n    range: {\n      sheetId: sheetId,\n      startRowIndex: 0,\n      endRowIndex: rowCount,\n      startColumnIndex: 0,\n      endColumnIndex: COLUMN_COUNT,\n    },\n    cell: {\n      userEnteredFormat: {\n        borders: {\n          top: { style: 'SOLID' },\n          bottom: { style: 'SOLID' },\n          left: { style: 'SOLID' },\n          right: { style: 'SOLID' },\n        },\n      },\n    },\n    fields: 'userEnteredFormat.borders',\n  },\n});\nrequests.push({\n  addConditionalFormatRule: {\n    rule: {\n      ranges: [{\n        sheetId: sheetId,\n        startRowIndex: 1,\n        endRowIndex: 1000,\n        startColumnIndex: 0,\n        endColumnIndex: COLUMN_COUNT,\n      }],\n      booleanRule: {\n        condition: { type: 'CUSTOM_FORMULA', values: [{ userEnteredValue: '=$V2=TRUE' }] },\n        format: {\n          backgroundColor: { red: 217 / 255, green: 234 / 255, blue: 211 / 255 },\n        },\n      },\n    },\n    index: 0,\n  },\n});\nreturn [{ json: { requests: requests } }];"
      },
      "id": "afc5a085-4135-46d0-bdaf-1b30a65ed421",
