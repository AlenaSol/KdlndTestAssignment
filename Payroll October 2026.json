      "parameters": {
        "jsCode": "// Collect the four source tabs into one payload for the Apps Script engine.\n// All routing, validation, calculation and reconciliation happens in the\n// Apps Script Web App (Code.gs) so the rules live in exactly one place.\nconst tabData = (nodeName) => {\n  const proxy = $(nodeName);\n  const items = typeof proxy.all === 'function' ? proxy.all() : proxy.all;\n  return (items || []).map((item) => item.json);\n};\nreturn [{ json: {\n  employees: tabData('Read Employees'),\n  activity: tabData('Read Activity'),\n  adjustments: tabData('Read Adjustments'),\n  manual: tabData('Read Manual Payroll'),\n} }];"
      },
